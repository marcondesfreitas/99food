{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "99motorista",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "99motorista",
        "start"
      ],
      "port": 8081
    },
    {
      "name": "99motorista-web-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "99motorista/dist",
        "-s",
        "-l",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "99motorista-8090",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8090"
      ],
      "port": 8090,
      "cwd": "99motorista"
    }
  ]
}